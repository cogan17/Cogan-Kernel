# Hardening beyond the stock kernel (owner 2026-11-07, security audit r13/r14). Boot defaults only:
# no KMI type changes, and root can still change the value while the phone runs.
#
# The kernel log can be read only with CAP_SYSLOG (root, logd), as AOSP's init.rc once set it.
# On the owner's phone dmesg_restrict was 0 (SELinux was the only guard).
CONFIG_SECURITY_DMESG_RESTRICT=y
#
# Unprivileged BPF is deliberately left as Google's gki_defconfig has it: Android's own BPF loader
# (NetBpfLoad, bpfloader.rc) writes /proc/sys/kernel/unprivileged_bpf_disabled = 0 at every boot
# ("we need 0"), and its service reboots on failure; SELinux keeps apps away from bpf().
